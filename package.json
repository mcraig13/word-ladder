    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
